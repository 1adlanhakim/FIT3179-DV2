{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot map of NSW Regional Conservatorium Grants Program recipient locations.",
  "width": "container",
  "height": 420,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STATE_NAME === 'New South Wales'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eee9e2",
        "stroke": "#9b938b",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "data/conservatorium_grants_2025_26.csv"
      },
      "mark": {
        "type": "circle",
        "size": 105,
        "color": "#117a7a",
        "stroke": "#fffdf9",
        "strokeWidth": 1.2,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "recipient",
            "type": "nominal",
            "title": "Conservatorium"
          },
          {
            "field": "city",
            "type": "nominal",
            "title": "Location"
          },
          {
            "field": "amount",
            "type": "quantitative",
            "title": "Approved grant ($)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#556170",
      "titleColor": "#27313f",
      "gridColor": "#eee9e2",
      "domainColor": "#c9c2b9",
      "tickColor": "#c9c2b9",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#4b5563",
      "titleColor": "#27313f",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 1.5
    }
  }
}