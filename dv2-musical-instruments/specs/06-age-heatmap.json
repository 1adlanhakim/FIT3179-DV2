{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap of music behaviours by age group, with quantitative colour luminance and direct value labels.",
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/music_behaviour_by_age_2025.csv"
  },
  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "sort": [
        "15-24",
        "25-34",
        "35-44",
        "45-54",
        "55-64",
        "65+"
      ],
      "title": "Age group",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "behaviour",
      "type": "nominal",
      "sort": [
        "Create music",
        "Paid streaming",
        "Stream music",
        "Radio"
      ],
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 2
      },
      "encoding": {
        "color": {
          "field": "percentage",
          "type": "quantitative",
          "title": "Participation (%)",
          "scale": {
            "domain": [
              0,
              90
            ],
            "scheme": "teals"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 210
          }
        },
        "tooltip": [
          {
            "field": "behaviour",
            "type": "nominal"
          },
          {
            "field": "age_group",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Participation (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "percentage",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.percentage >= 55",
            "value": "#ffffff"
          },
          "value": "#25313d"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#556170",
      "titleColor": "#27313f",
      "gridColor": "#eee9e2",
      "domainColor": "#c9c2b9",
      "tickColor": "#c9c2b9",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#4b5563",
      "titleColor": "#27313f",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 1.5
    }
  }
}