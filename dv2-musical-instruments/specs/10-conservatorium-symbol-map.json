{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional-symbol map of approved NSW regional conservatorium grant amounts.",
  "width": "container",
  "height": 420,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STATE_NAME === 'New South Wales'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eee9e2",
        "stroke": "#9b938b",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "data/conservatorium_grants_2025_26.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#92264a",
        "opacity": 0.68,
        "stroke": "#6f1636",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "amount",
          "type": "quantitative",
          "title": "Approved grant ($)",
          "scale": {
            "domain": [0, 600000],
            "range": [0, 700]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              300000,
              450000,
              570802
            ],
            "format": "$~s"
          }
        },
        "tooltip": [
          {
            "field": "recipient",
            "type": "nominal",
            "title": "Conservatorium"
          },
          {
            "field": "city",
            "type": "nominal",
            "title": "Location"
          },
          {
            "field": "amount",
            "type": "quantitative",
            "title": "Approved grant ($)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#556170",
      "titleColor": "#27313f",
      "gridColor": "#eee9e2",
      "domainColor": "#c9c2b9",
      "tickColor": "#c9c2b9",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#4b5563",
      "titleColor": "#27313f",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 1.5
    }
  }
}