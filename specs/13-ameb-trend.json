{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "AMEB NSW examination totals for 2023–24 and 2024–25.",
  "width": "container",
  "height": 200,
  "data": {
    "url": "data/ameb_trend_2023_24_2024_25.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "color": "#117a7a",
        "size": 70
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "2023–24",
            "2024–25"
          ],
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "examinations",
          "type": "quantitative",
          "title": "Examinations",
          "scale": {
            "zero": true,
            "domain": [
              0,
              34000
            ]
          },
          "axis": {
            "format": "~s"
          }
        },
        "tooltip": [
          {
            "field": "period",
            "type": "nominal",
            "title": "Reporting period"
          },
          {
            "field": "examinations",
            "type": "quantitative",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -10,
        "fontWeight": 700,
        "fontSize": 12,
        "color": "#27313f"
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "2023–24",
            "2024–25"
          ]
        },
        "y": {
          "field": "examinations",
          "type": "quantitative"
        },
        "text": {
          "field": "examinations",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#556170",
      "titleColor": "#27313f",
      "gridColor": "#eee9e2",
      "domainColor": "#c9c2b9",
      "tickColor": "#c9c2b9",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#4b5563",
      "titleColor": "#27313f",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 1.5
    }
  }
}