{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Comparison of instrument participation for men and women.",
  "width": "container",
  "height": 190,
  "data": {
    "url": "data/gss_instrument_by_gender_2025.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "height": 26
      },
      "encoding": {
        "x": {
          "field": "percentage",
          "type": "quantitative",
          "title": "Participation (%)",
          "scale": {
            "domain": [
              0,
              9
            ],
            "zero": true
          }
        },
        "y": {
          "field": "gender",
          "type": "nominal",
          "sort": {
            "field": "percentage",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 12
          }
        },
        "color": {
          "field": "gender",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Men",
              "Women"
            ],
            "range": [
              "#117a7a",
              "#d7a72c"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "gender",
            "type": "nominal",
            "title": "Gender"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Participation (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#27313f"
      },
      "encoding": {
        "x": {
          "field": "percentage",
          "type": "quantitative"
        },
        "y": {
          "field": "gender",
          "type": "nominal",
          "sort": {
            "field": "percentage",
            "order": "descending"
          }
        },
        "text": {
          "field": "percentage",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#556170",
      "titleColor": "#27313f",
      "gridColor": "#eee9e2",
      "domainColor": "#c9c2b9",
      "tickColor": "#c9c2b9",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#4b5563",
      "titleColor": "#27313f",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 1.5
    }
  }
}