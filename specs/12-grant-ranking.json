{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ranked bars of approved conservatorium grants, highlighting highest and lowest amounts.",
  "width": "container",
  "height": 430,
  "data": {
    "url": "data/conservatorium_grants_2025_26.csv"
  },
  "transform": [
    {
      "calculate": "datum.amount == 570802 ? 'Maximum' : datum.amount == 292212 ? 'Minimum' : 'Other'",
      "as": "grant_level"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "amount",
      "type": "quantitative",
      "title": "Approved grant ($)",
      "axis": {
        "format": "$~s"
      },
      "scale": {
        "zero": true
      }
    },
    "y": {
      "field": "city",
      "type": "nominal",
      "sort": {
        "field": "amount",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelLimit": 130
      }
    },
    "color": {
      "field": "grant_level",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Maximum",
          "Other",
          "Minimum"
        ],
        "range": [
          "#92264a",
          "#c8c1b9",
          "#d7a72c"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "recipient",
        "type": "nominal",
        "title": "Conservatorium"
      },
      {
        "field": "city",
        "type": "nominal"
      },
      {
        "field": "amount",
        "type": "quantitative",
        "title": "Approved grant ($)",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#556170",
      "titleColor": "#27313f",
      "gridColor": "#eee9e2",
      "domainColor": "#c9c2b9",
      "tickColor": "#c9c2b9",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#4b5563",
      "titleColor": "#27313f",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 1.5
    }
  }
}