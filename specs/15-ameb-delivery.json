{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Comparison of face-to-face and video-submission practical music assessments in AMEB NSW, 2024\u201325.",
  "width": "container",
  "height": 180,
  "data": {
    "url": "data/ameb_delivery_2024_25.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "x": {
          "field": "examinations",
          "type": "quantitative",
          "title": "Practical assessments",
          "axis": {
            "format": "~s",
            "values": [0, 5000, 10000, 15000, 20000]
          },
          "scale": {
            "domain": [0, 20000],
            "zero": true
          }
        },
        "y": {
          "field": "delivery_mode",
          "type": "nominal",
          "sort": {
            "field": "examinations",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelLimit": 155
          }
        },
        "color": {
          "field": "delivery_mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Face-to-face practical",
              "Video submission practical"
            ],
            "range": [
              "#117a7a",
              "#d7a72c"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "delivery_mode",
            "type": "nominal",
            "title": "Mode"
          },
          {
            "field": "examinations",
            "type": "quantitative",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontWeight": 700,
        "fontSize": 11,
        "color": "#27313f"
      },
      "encoding": {
        "x": {
          "field": "examinations",
          "type": "quantitative"
        },
        "y": {
          "field": "delivery_mode",
          "type": "nominal",
          "sort": {
            "field": "examinations",
            "order": "descending"
          }
        },
        "text": {
          "field": "examinations",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#556170",
      "titleColor": "#27313f",
      "gridColor": "#eee9e2",
      "domainColor": "#c9c2b9",
      "tickColor": "#c9c2b9",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#4b5563",
      "titleColor": "#27313f",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolStrokeWidth": 1.5
    }
  }
}