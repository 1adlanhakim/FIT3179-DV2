{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive bump chart showing changing age-group rankings across music behaviours.",

  "width": "container",
  "height": 330,

  "params": [
    {
      "name": "ageHighlight",
      "select": {
        "type": "point",
        "fields": [
          "age_group"
        ]
      },
      "bind": "legend"
    }
  ],

  "data": {
    "url": "data/music_behaviour_by_age_2025.csv"
  },

  "mark": {
    "type": "line",
    "strokeWidth": 3,
    "point": {
      "filled": true,
      "size": 85
    }
  },

  "encoding": {
    "x": {
      "field": "behaviour",
      "type": "ordinal",
      "sort": [
        "Create music",
        "Paid streaming",
        "Stream music",
        "Radio"
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelPadding": 7
      }
    },

    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank (1 = highest)",
      "scale": {
        "domain": [
          1,
          6
        ],
        "reverse": true
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "tickMinStep": 1
      }
    },

    "color": {
      "field": "age_group",
      "type": "nominal",
      "title": "Age group",
      "scale": {
        "domain": [
          "15-24",
          "25-34",
          "35-44",
          "45-54",
          "55-64",
          "65+"
        ],
        "range": [
          "#92264a",
          "#d45c32",
          "#d7a72c",
          "#5c8c85",
          "#3f6f8f",
          "#7a7069"
        ]
      }
    },

    "opacity": {
      "condition": {
        "param": "ageHighlight",
        "value": 1
      },
      "value": 0.2
    },

    "detail": {
      "field": "age_group",
      "type": "nominal"
    },

    "tooltip": [
      {
        "field": "age_group",
        "type": "nominal",
        "title": "Age group"
      },
      {
        "field": "behaviour",
        "type": "nominal",
        "title": "Behaviour"
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Participation (%)",
        "format": ".1f"
      },
      {
        "field": "rank",
        "type": "quantitative",
        "title": "Rank",
        "format": ".0f"
      }
    ]
  },

  "config": {
    "font": "Inter, Arial, sans-serif",

    "view": {
      "stroke": null
    },

    "axis": {
      "labelColor": "#556170",
      "titleColor": "#27313f",
      "gridColor": "#eee9e2",
      "domainColor": "#c9c2b9",
      "tickColor": "#c9c2b9",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },

    "legend": {
      "labelColor": "#4b5563",
      "titleColor": "#27313f",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "symbolSize": 100
    }
  }
}